# Local dev: optional — skip login while coding
# NEXT_PUBLIC_DASHBOARD_AUTH_DISABLED=1

# Production / GitHub Pages build (required for login gate)
NEXT_PUBLIC_DASHBOARD_USERNAME=usc-adrc
# bcrypt hash — NOT the plain password. Generate with:
#   node scripts/hash_dashboard_password.mjs 'YourPasswordHere'
NEXT_PUBLIC_DASHBOARD_PASSWORD_HASH=

# GitHub Pages project site (set in CI; empty for local dev)
# NEXT_PUBLIC_BASE_PATH=/ClinicalCore_Aim1
